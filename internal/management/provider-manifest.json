{
  "format": "mi-mcp-provider/v2",
  "namespace": "telegram",
  "binary": "mi-telegram-cli",
  "provider_version": "0.1.0",
  "description": "CLI local para QA conversacional de Telegram mediante perfiles QA existentes y autorizados.",
