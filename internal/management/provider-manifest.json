      "invocation": {"kind": "cli", "command": "mi-telegram-cli", "fixed_args": ["messages", "send-photo"], "input_mapping": {"fields": {"profile": {"source": "option", "flag": "--profile"}, "peer": {"source": "option", "flag": "--peer"}, "file": {"source": "option", "flag": "--file"}, "caption": {"source": "option", "flag": "--caption"}, "json": {"source": "option", "flag": "--json"}}}, "output": "json"}
    },
