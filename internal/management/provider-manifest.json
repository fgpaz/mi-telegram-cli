      "effect": "read",
      "contract": "cli-doctor-v0",
      "input_schema": {"type": "object", "properties": {}, "required": [], "additionalProperties": false},
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {"const": true},
          "data": {
            "type": "object",
            "properties": {
              "status": {"type": "string", "enum": ["ok", "explicit_incomplete"]},
              "read_only": {"const": true}, "redacted": {"const": true},
              "checks": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "status": {"type": "string"}}, "required": ["name", "status"], "additionalProperties": false}},
              "gaps": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["status", "read_only", "redacted", "checks", "gaps"], "additionalProperties": false
          }
        },
        "required": ["ok", "data"], "additionalProperties": false
      },
      "invocation": {"kind": "cli", "command": "mi-telegram-cli", "fixed_args": ["doctor"], "input_mapping": {"fields": {}}, "output": "json"}
    },
