    "doctor": "cli-doctor-v0",
    "projects bind": "RF-PRJ-001",
    "projects current": "RF-PRJ-002",
    "projects list": "RF-PRJ-001",
    "auth status": "RF-AUT-002",
    "messages send": "RF-MSG-002",
    "messages send-photo": "RF-MSG-006",
    "messages read": "RF-MSG-001",
    "messages wait": "RF-MSG-003",
