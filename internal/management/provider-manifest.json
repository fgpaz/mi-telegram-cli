      "invocation": {"kind": "cli", "command": "mi-telegram-cli", "fixed_args": ["messages", "read"], "input_mapping": {"fields": {"profile": {"source": "option", "flag": "--profile"}, "peer": {"source": "option", "flag": "--peer"}, "limit": {"source": "option", "flag": "--limit"}, "after_id": {"source": "option", "flag": "--after-id"}, "json": {"source": "option", "flag": "--json"}}}, "output": "json"}
