        },
        "required": ["root", "profile", "json"], "additionalProperties": false
      },
      "output_schema": {"type": "object", "properties": {"ok": {"type": "boolean"}, "profile": {"type": "string"}, "data": {"type": ["object", "null"], "properties": {"binding": {"type": "object", "properties": {"projectRoot": {"type": "string"}, "profileId": {"type": "string"}, "displayName": {"type": "string"}, "createdAtUtc": {"type": "string", "format": "date-time"}, "updatedAtUtc": {"type": "string", "format": "date-time"}}, "required": ["projectRoot", "profileId", "createdAtUtc", "updatedAtUtc"], "additionalProperties": false}}, "required": ["binding"], "additionalProperties": false}, "error": {"type": ["object", "null"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}, "required": ["code", "message"], "additionalProperties": false}, "queueMs": {"type": "integer", "minimum": 0}}, "required": ["ok", "profile", "data", "error"], "additionalProperties": false},
      "invocation": {"kind": "cli", "command": "mi-telegram-cli", "fixed_args": ["projects", "bind"], "input_mapping": {"fields": {"root": {"source": "option", "flag": "--root"}, "profile": {"source": "option", "flag": "--profile"}, "json": {"source": "option", "flag": "--json"}}}, "output": "json"}
    },
    {
