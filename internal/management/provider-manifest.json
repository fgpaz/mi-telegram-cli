      "output_schema": {"type": "object", "properties": {"ok": {"type": "boolean"}, "profile": {"type": "string"}, "data": {"type": ["object", "null"], "properties": {"peer": {"type": "object", "properties": {"id": {"type": "integer"}, "kind": {"type": "string"}, "displayName": {"type": "string"}, "username": {"type": "string"}}, "required": ["id", "kind", "displayName"], "additionalProperties": false}, "message": {"type": "object", "properties": {"id": {"type": "integer"}, "direction": {"type": "string"}, "text": {"type": "string"}, "sentAtUtc": {"type": "string", "format": "date-time"}, "attachments": {"type": "array", "items": {"type": "object", "properties": {"kind": {"type": "string"}, "summary": {"type": "string"}, "details": {"type": "object", "additionalProperties": true}}, "required": ["kind", "summary"], "additionalProperties": false}}, "buttons": {"type": "array", "items": {"type": "object", "properties": {"index": {"type": "integer"}, "row": {"type": "integer"}, "col": {"type": "integer"}, "kind": {"type": "string"}, "text": {"type": "string"}, "actionable": {"type": "boolean"}, "url": {"type": "string"}, "requiresPassword": {"type": "boolean"}}, "required": ["index", "row", "col", "kind", "text", "actionable"], "additionalProperties": false}}}, "required": ["id", "direction", "text", "sentAtUtc", "attachments", "buttons"], "additionalProperties": false}, "observedAtUtc": {"type": "string", "format": "date-time"}}, "required": ["peer", "message", "observedAtUtc"], "additionalProperties": false}, "error": {"type": ["object", "null"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}, "required": ["code", "message"], "additionalProperties": false}, "queueMs": {"type": "integer", "minimum": 0}}, "required": ["ok", "profile", "data", "error"], "additionalProperties": false},
