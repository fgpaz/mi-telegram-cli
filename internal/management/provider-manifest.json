      "invocation": {"kind": "cli", "command": "mi-telegram-cli", "fixed_args": ["auth", "status"], "input_mapping": {"fields": {"profile": {"source": "option", "flag": "--profile"}, "json": {"source": "option", "flag": "--json"}}}, "output": "json"}
    },
