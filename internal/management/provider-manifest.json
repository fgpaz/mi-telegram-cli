      "description": "Muestra versión y procedencia del binario.",
      "effect": "read",
      "contract": "cli-version-v0",
      "input_schema": {"type": "object", "properties": {}, "required": [], "additionalProperties": false},
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {"const": true},
          "data": {
            "type": "object",
            "properties": {
              "version": {"type": "string"}, "commit": {"type": "string"}, "build_time": {"type": "string"},
              "go": {"type": "string"}, "os": {"type": "string"}, "arch": {"type": "string"},
              "vcs_modified": {"type": "string", "enum": ["true", "false", "unknown"]}
            },
            "required": ["version", "commit", "build_time", "go", "os", "arch", "vcs_modified"],
            "additionalProperties": false
          }
        },
        "required": ["ok", "data"], "additionalProperties": false
      },
      "invocation": {"kind": "cli", "command": "mi-telegram-cli", "fixed_args": ["version"], "input_mapping": {"fields": {}}, "output": "json"}
    },
    {
